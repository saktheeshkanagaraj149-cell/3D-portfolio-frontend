PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# The database name goes after the host, here "portfolio".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Gmail App Password (Google Account → Security → App passwords), not your login password.
# Leave blank to only save messages in MongoDB.
EMAIL_USER=saktheeshkanagaraj149@gmail.com
EMAIL_PASS=
EMAIL_TO=saktheeshkanagaraj149@gmail.com

# Frontend URL(s) for CORS, comma-separated. *.vercel.app is always allowed.
CLIENT_URL=http://localhost:5173

# On startup the server copies client/src/data/projects.json into MongoDB
# (and removes projects deleted from the file). Set to false to manage the DB by hand.
SYNC_ON_START=true

# Optional: avoids GitHub's 60 requests/hour limit when running `npm run seed`
GITHUB_TOKEN=

NODE_ENV=development
